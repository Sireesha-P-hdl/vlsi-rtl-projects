module Synup_down(
input clk,
input reset,
input updown,
output reg [3:0]q
    );
    wire t0,t1,t2,t3;
    assign t0=1'b1;
    assign t1=updown?q[0]:~q[0];
    assign t2=updown?(q[1]&q[0]):(~q[1]&~q[0]);
    assign t3=updown?(q[2]&q[1]&q[0]):(~q[2]&~q[1]&~q[0]);

    always @(posedge clk)begin
    if(reset)
    q<=4'b0000;
    else begin
    if(t0)
    q[0]<=~q[0];
     if(t1)
    q[1]<=~q[1];
     if(t2)
    q[2]<=~q[2];
     if(t3)
    q[3]<=~q[3];
    end
    end
endmodule
