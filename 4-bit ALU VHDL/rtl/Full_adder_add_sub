 module F_A(
    input A,B,C,
    output Sum,Carry
    );
    assign Sum=A^B^C;
    assign Carry=A&B|B&C|C&A;
endmodule
module add_sub(M,a0,a1,a2,a3,b0,b1,b2,b3,s0,s1,s2,s3,carry);
    input M,a0,a1,a2,a3,b0,b1,b2,b3;
    output s0,s1,s2,s3,carry;
    wire t0,t1,t2,t3,c1,c2,c3;
    xor(t0,b0,M); 
    xor(t1,b1,M); 
    xor(t2,b2,M); 
    xor(t3,b3,M); 
    F_A block0(a0,b0,M,s0,c1);
    F_A block1(a1,b1,c1,s1,c2);
    F_A block2(a2,b2,c2,s2,c3);
    F_A block3(a3,b3,c3,s3,carry);
endmodule
