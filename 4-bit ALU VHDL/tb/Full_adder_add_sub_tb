module add_sub_tb;

    reg M;
    reg a0, a1, a2, a3;
    reg b0, b1, b2, b3;
    wire s0, s1, s2, s3, carry;
   
    add_sub uut (
        M,a0,a1,a2,a3,b0,b1,b2,b3,s0,s1,s2,s3,carry
    );

    initial begin
        

        // ADD: 5 + 3 = 8
        M  = 0;
        a3 = 0; a2 = 1; a1 = 0; a0 = 1;   // A = 0101
        b3 = 0; b2 = 0; b1 = 1; b0 = 1;   // B = 0011
        #10;

        // ADD: 9 + 6 = 15
        M  = 0;
        a3 = 1; a2 = 0; a1 = 0; a0 = 1;   // A = 1001
        b3 = 0; b2 = 1; b1 = 1; b0 = 0;   // B = 0110
        #10;

        // SUB: 5 - 3 = 2
        M  = 1;
        a3 = 0; a2 = 1; a1 = 0; a0 = 1;   // A = 0101
        b3 = 0; b2 = 0; b1 = 1; b0 = 1;   // B = 0011
        #10;

        // SUB: 9 - 6 = 3
        M  = 1;
        a3 = 1; a2 = 0; a1 = 0; a0 = 1;   // A = 1001
        b3 = 0; b2 = 1; b1 = 1; b0 = 0;   // B = 0110
        #10;

        // ADD: 7 + 8 = 15
        M  = 0;
        a3 = 0; a2 = 1; a1 = 1; a0 = 1;   // A = 0111
        b3 = 1; b2 = 0; b1 = 0; b0 = 0;   // B = 1000
        #10;

        $finish;
    end

endmodule
