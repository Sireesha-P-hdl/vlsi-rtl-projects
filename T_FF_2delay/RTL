`timescale 1ns / 1ps
module T_FF(
input clk,
input reset,
input t,
output reg q,
output q1
    );
    reg t1,t2;
    always @(posedge clk)begin 
    if(reset)
    t1<=1'b0;
    else if(t)
    t1<=~t;
    else
    t1<=t;
    end
    always @(posedge clk)begin 
    if(reset)begin
    t2<=1'b0;
    q<=1'b0;
    end
    else begin
     t2<=t1;
    q<=t2;
     end
    end
    assign q1=~q;
endmodule
