module clk_tb();


    reg clk = 0;
    reg reset, load;
    reg [3:0] load_ms_hr, load_ls_hr, load_ms_min, load_ls_min;
    wire [3:0] time_ms_hr, time_ls_hr, time_ms_min, time_ls_min;

    integer errors = 0;

    Clock uut (
        .clk(clk), .reset(reset), .load(load),
        .load_ms_hr(load_ms_hr), .load_ls_hr(load_ls_hr),
        .load_ms_min(load_ms_min), .load_ls_min(load_ls_min),
        .time_ms_hr(time_ms_hr), .time_ls_hr(time_ls_hr),
        .time_ms_min(time_ms_min), .time_ls_min(time_ls_min)
    );

    always #5 clk = ~clk;

    // check the four digits against what we expect
    task check(input [3:0] a, b, c, d);
        begin
            if (time_ms_hr !== a || time_ls_hr !== b ||
                time_ms_min !== c || time_ls_min !== d) begin
                $display("FAIL: got %0d%0d:%0d%0d  expected %0d%0d:%0d%0d",
                    time_ms_hr, time_ls_hr, time_ms_min, time_ls_min, a, b, c, d);
                errors = errors + 1;
            end
            else
                $display("PASS: %0d%0d:%0d%0d", a, b, c, d);
        end
    endtask

    initial begin
        // reset
        reset = 1; load = 0;
        repeat (2) @(negedge clk);
        reset = 0;
        check(0, 0, 0, 0);

        // load 15:26, then wait 60 clocks for one minute to pass
        load = 1;
        load_ms_hr = 1; load_ls_hr = 5; load_ms_min = 2; load_ls_min = 6;
        @(negedge clk);
        load = 0;
        check(1, 5, 2, 6);

        repeat (61) @(negedge clk);
        check(1, 5, 2, 7);          // 15:26 -> 15:27

        // 15:59 -> 16:00
        load = 1;
        load_ms_hr = 1; load_ls_hr = 5; load_ms_min = 5; load_ls_min = 9;
        @(negedge clk);
        load = 0;
        repeat (61) @(negedge clk);
        check(1, 6, 0, 0);

        // 09:59 -> 10:00
        load = 1;
        load_ms_hr = 0; load_ls_hr = 9; load_ms_min = 5; load_ls_min = 9;
        @(negedge clk);
        load = 0;
        repeat (61) @(negedge clk);
        check(1, 0, 0, 0);

        // 23:59 -> 00:00
        load = 1;
        load_ms_hr = 2; load_ls_hr = 3; load_ms_min = 5; load_ls_min = 9;
        @(negedge clk);
        load = 0;
        repeat (61) @(negedge clk);
        check(0, 0, 0, 0);

        if (errors == 0) $display("ALL PASSED");
        else             $display("%0d FAILURES", errors);
        #2000;
        $finish;
    end

endmodule
