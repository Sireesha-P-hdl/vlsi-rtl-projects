module Clock(
input clk,
input reset,
input load,
input [3:0] load_ms_hr,load_ms_min, 
input [3:0] load_ls_hr,load_ls_min, 
output reg [3:0] time_ms_hr,time_ms_min, 
output reg [3:0] time_ls_hr,time_ls_min 
    );
 reg [5:0]count;
 reg one_min_reg;
 always @(posedge clk or posedge reset)begin
 if(reset)begin
 count<=6'b0;
 one_min_reg<=1'b0;
 end else if(load)begin
 count<=6'b0;
 one_min_reg<=1'b0;
 end
 else if(count==6'd59)begin
 count<=6'b0;
 one_min_reg<=1'b1;
 end
 else begin
 count<=count+1'b1;
 one_min_reg<=1'b0;
 end
 end
 always @(posedge clk or posedge reset)begin
 if(reset)begin
 time_ms_hr<=4'b0;
 time_ls_hr<=4'b0;
 time_ms_min<=4'b0;
 time_ls_min<=4'b0;
 end
 else if(load)begin
 time_ms_hr<=load_ms_hr;
 time_ls_hr<=load_ls_hr;
 time_ms_min<=load_ms_min;
 time_ls_min<=load_ls_min;
 end
 else if(one_min_reg)begin 
 if((time_ms_hr==4'd2&&time_ls_hr==4'd3)&&(time_ms_min==4'd5&&time_ls_min==4'd9))begin
 time_ms_hr<=4'b0;
 time_ls_hr<=4'b0;
 time_ms_min<=4'b0;
 time_ls_min<=4'b0;
 end
 else if((time_ls_hr==4'd9)&&(time_ms_min==4'd5&&time_ls_min==4'd9))begin
 time_ms_hr<=time_ms_hr+1'b1;
 time_ls_hr<=4'b0;
 time_ms_min<=4'b0;
 time_ls_min<=4'b0;
 end
 else if((time_ms_min==4'd5&&time_ls_min==4'd9))begin
 time_ls_hr<=time_ls_hr+1'b1;
  time_ms_min<=4'b0;
 time_ls_min<=4'b0;
 end
 else if(time_ls_min==4'd9)begin
 time_ms_min<=time_ms_min+1'b1;
  time_ls_min<=4'b0;
 end
 else begin 
  time_ls_min<=time_ls_min+1'b1;
  end
 end
 end
endmodule
