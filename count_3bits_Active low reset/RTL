`timescale 1ns / 1ps
module count_3bits(
input clk,
input reset,
input updown,
output reg [2:0]count
    );
    always @(posedge clk)begin
    if(!reset)
    count<=3'b000;
    else 
    if(updown==1)
    if(count==3'b100)
    count<=3'b000;
    else
    count<=count+1'b1;
    else 
    if(count==3'b000)
    count<=3'b100;
    else
    count<=count-1'b1;
    end
endmodule
