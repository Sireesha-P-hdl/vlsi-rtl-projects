`timescale 1ns / 1ps
module enc(
input [15:0]D,
output reg [3:0]y,
output valid
    );
    always @(*)begin
   casez(D)
  
    16'b0000000000000000 : y = 4'bxxxx;

   16'b1000000000000000 : y = 4'b1111; // D15
   16'b?100000000000000 : y = 4'b1110; // D14
   16'b??10000000000000 : y = 4'b1101; // D13
   16'b???1000000000000 : y = 4'b1100; // D12
   16'b????100000000000 : y = 4'b1011; // D11
   16'b?????10000000000 : y = 4'b1010; // D10
   16'b??????1000000000 : y = 4'b1001; // D9
   16'b???????100000000 : y = 4'b1000; // D8
   16'b????????10000000 : y = 4'b0111; // D7
   16'b?????????1000000 : y = 4'b0110; // D6
   16'b??????????100000 : y = 4'b0101; // D5
   16'b???????????10000:  y = 4'b0100; // D4
   16'b????????????1000 : y = 4'b0011; // D3
   16'b?????????????100 : y = 4'b0010; // D2
   16'b??????????????10 : y = 4'b0001; // D1
   16'b???????????????1 : y = 4'b0000; // D0
  
endcase
  
 
    end
    assign valid = |D;
endmodule
