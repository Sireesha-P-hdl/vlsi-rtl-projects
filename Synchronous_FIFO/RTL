`timescale 1ns / 1ps
//reset          wr=0_0000  rd=0_0000   empty=1  full=0
//write A        wr=0_0001  rd=0_0000   empty=0  full=0
//write B        wr=0_0010  rd=0_0000   empty=0  full=0
//...
//write 15th     wr=0_1111  rd=0_0000   empty=0  full=0
//write 16th     wr=1_0000  rd=0_0000   empty=0  full=1   <-- wrap bit flipped
//wr_ptr[4] != rd_ptr[4] → 1 != 0 → true
//wr_ptr[3:0] == rd_ptr[3:0] → 0000 == 0000 → true

//Both terms true, so full = 1.
//do_write = !write_n && !full;
//write_n	full	!write_n	!full	do_write	what happens
//1     	0	      0	       1	     0	     no request — nothing
//1     	1	      0      	 0	     0	     no request — nothing
//0     	0     	1        1	     1	     write happens
//0	      1	      1	       0	     0	     request ignored, FIFO is full

// ============================================================
// Synchronous FIFO
// 8 bits wide, 16 deep, flip-flop based memory
// read_n and write_n are active low
// reset is asynchronous, active low
// ============================================================
 module Sync_FIFO(clk, reset, data_in, read_n, write_n,
                  data_out, full, empty);

    input             clk, reset;
    input             read_n, write_n;
    input      [7:0]  data_in;
    output reg [7:0]  data_out;
    output            full, empty;

    // flip-flop bank
    reg [7:0] mem [0:15];

    // pointers carry an extra MSB to separate full from empty
    reg [4:0] wr_ptr, rd_ptr;

    // empty: pointers identical, including the wrap bit
    assign empty = (wr_ptr == rd_ptr);

    // full: same address, opposite wrap bit
    assign full  = (wr_ptr[4] != rd_ptr[4]) &&
                   (wr_ptr[3:0] == rd_ptr[3:0]);

    // active-low controls, gated so overflow and underflow are impossible
    wire do_write = !write_n && !full;
    wire do_read  = !read_n  && !empty;

    integer i;

    always @(posedge clk or negedge reset) begin
        if (!reset) begin
            wr_ptr   <= 5'b0;
            rd_ptr   <= 5'b0;
            data_out <= 8'b0;
            for (i = 0; i < 16; i = i + 1)
                mem[i] <= 8'b0;
        end
        else begin
            // write and read are independent, so both can happen together
            if (do_write) begin
                mem[wr_ptr[3:0]] <= data_in;
                wr_ptr           <= wr_ptr + 1'b1;
            end

            if (do_read) begin
                data_out <= mem[rd_ptr[3:0]];
                rd_ptr   <= rd_ptr + 1'b1;
            end
        end
    end

endmodule
