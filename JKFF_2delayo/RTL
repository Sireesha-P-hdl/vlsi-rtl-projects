`timescale 1ns / 1ps
module jk_2delay(
input clk,
input reset,
input j,
input k,
output reg q,
output q1
    );
   
    reg t1,t2;
    always @(posedge clk)begin
    if(reset)
    t1<=1'b0;
    else begin
    case({j,k})
    2'b00:t1<=t1;
    2'b01:t1<=1'b0;
    2'b10:t1<=1'b1;
    2'b11:t1<=~t1;
    endcase
    end
    end
    always @(posedge clk)begin
    if(reset)begin
    t2<=1'b0;
    q<=1'b0;
   end else begin
    t2<=t1;
    q<=t2;  
    end
    end
    assign q1=~q;
endmodule
